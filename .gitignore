# =====================================================================
#  .gitignore — Proyecto final SIS-216 (Mi Teleférico)
#  Ignora artefactos generados; conserva el código y los entregables
#  (README, docs/, modelo/*.nlogo, analisis/*.py y *.csv, el PDF).
# =====================================================================

# -------------------- Node.js / Next.js (carpeta web/) ----------------
node_modules/
.next/
out/
build/
.swc/
.turbo/
*.tsbuildinfo
next-env.d.ts

# Logs y depuración
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/

# Gestores de paquetes alternativos (se versiona package-lock.json)
.pnp
.pnp.js
yarn.lock
pnpm-lock.yaml

# -------------------- Python (carpeta analisis/) ----------------------
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/

# Entornos virtuales
.venv/
venv/
env/
ENV/

# -------------------- Variables de entorno / secretos -----------------
.env
.env.*
!.env.example

# -------------------- NetLogo -----------------------------------------
# Copias de respaldo y exportaciones automáticas (NO los .nlogo ni los .csv de datos)
*.nlogo.bak
*~

# -------------------- Editores / IDE ----------------------------------
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo

# -------------------- Sistema operativo -------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# -------------------- Temporales del proyecto -------------------------
# Logs del servidor de desarrollo generados durante pruebas
web/server.log
web/server.err
web/s.log
web/s.err
*.tmp
*.log
